    "test:selection": "node scripts/selection-check.mjs",
    "test:world": "tsx scripts/world-check.ts",
    "test:ports-visual": "tsx scripts/port-visual-check.ts",
    "test:navigation-regressions": "tsx scripts/navigation-regressions-check.ts",
